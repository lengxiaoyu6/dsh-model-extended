{
  "name": "dsh-model-extended",
  "version": "0.1.0",
  "description": "在 dsh 模型目录的每一行直接设置该模型的思考强度范围与支持的输入模态 (Per-model reasoning-effort range and accepted input modalities, right in the dsh Models catalog)",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-model-extended": "bin/dsh-model-extended.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengxiaoyu6/dsh-model-extended.git"
  },
  "homepage": "https://github.com/lengxiaoyu6/dsh-model-extended#readme",
  "bugs": {
    "url": "https://github.com/lengxiaoyu6/dsh-model-extended/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "input-modalities",
    "model-catalog"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
